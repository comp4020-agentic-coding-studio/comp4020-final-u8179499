# What a remote build uploads from your working tree. CI checkouts carry none
# of this, so it only matters for a deploy run from your own machine; without
# it, node_modules and any local data ship to the builder.
.git
node_modules
dist
*.log
.env
.env.*
.envrc
mise.local.toml
*.pem
# the visitor-cookie signing key the server creates beside its database
# (decisions/0003); a relative DB_PATH would otherwise put it in the tree,
# at any depth — unlike .gitignore, a bare name here only matches the root
**/identity-secret
.claude
